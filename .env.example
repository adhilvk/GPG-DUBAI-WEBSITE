# Copy this file to `.env.local` and fill in your values.

# Public site URL (used for metadata, share links, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudinary (server-side — do not expose API secret publicly)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Contact details (optional)
# NEXT_PUBLIC_WHATSAPP_NUMBER=971542068414
# NEXT_PUBLIC_CONTACT_EMAIL=enquiries@globalpropertygroup.co
